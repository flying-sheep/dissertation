\unprotect
\pgfdeclareshape{manifold}{
	%save anchor. they can’t be used in other saved anchors sadly
	\savedanchor{\centerpoint}{%
		\pgf@x=.5\wd\pgfnodeparttextbox%
		\pgf@y=.5\ht\pgfnodeparttextbox%
		\advance\pgf@y by-.5\dp\pgfnodeparttextbox%
	}%
	% Copied from /usr/share/texmf-dist/tex/generic/pgf/modules/pgfmoduleshapes.code.tex
	\saveddimen\radius{%
		% Calculate height radius
		\pgf@ya=.5\ht\pgfnodeparttextbox%
		\advance\pgf@ya by.5\dp\pgfnodeparttextbox%
		\pgfmathsetlength\pgf@yb{\pgfkeysvalueof{/pgf/inner ysep}}%
		\advance\pgf@ya by\pgf@yb%
		% Calculate width radius
		\pgf@xa=.5\wd\pgfnodeparttextbox%
		\pgfmathsetlength\pgf@xb{\pgfkeysvalueof{/pgf/inner xsep}}%
		\advance\pgf@xa by\pgf@xb%
		% Calculate length of radius vector:
		\pgf@process{\pgfpointnormalised{\pgfqpoint{\pgf@xa}{\pgf@ya}}}%
		\ifdim\pgf@x>\pgf@y%
			\c@pgf@counta=\pgf@x%
			\ifnum\c@pgf@counta=0\relax%
			\else%
			\divide\c@pgf@counta by 255\relax%
			\pgf@xa=16\pgf@xa\relax%
			\divide\pgf@xa by\c@pgf@counta%
			\pgf@xa=16\pgf@xa\relax%
			\fi%
		\else%
			\c@pgf@counta=\pgf@y%
			\ifnum\c@pgf@counta=0\relax%
			\else%
			\divide\c@pgf@counta by 255\relax%
			\pgf@ya=16\pgf@ya\relax%
			\divide\pgf@ya by\c@pgf@counta%
			\pgf@xa=16\pgf@ya\relax%
			\fi%
		\fi%
		\pgf@x=\pgf@xa%
		% If necessary, adjust radius so that the size requirements are met:
		\pgfmathsetlength{\pgf@xb}{\pgfkeysvalueof{/pgf/minimum width}}%
		\pgfmathsetlength{\pgf@yb}{\pgfkeysvalueof{/pgf/minimum height}}%
		\ifdim\pgf@x<.5\pgf@xb%
			\pgf@x=.5\pgf@xb%
		\fi%
		\ifdim\pgf@x<.5\pgf@yb%
			\pgf@x=.5\pgf@yb%
		\fi%
		% Now, add larger of outer separations.
		\pgfmathsetlength{\pgf@xb}{\pgfkeysvalueof{/pgf/outer xsep}}%
		\pgfmathsetlength{\pgf@yb}{\pgfkeysvalueof{/pgf/outer ysep}}%
		\ifdim\pgf@xb<\pgf@yb%
		\advance\pgf@x by\pgf@yb%
		\else%
		\advance\pgf@x by\pgf@xb%
		\fi%
	}%
	%
	\anchor{center}{\centerpoint}%
	\anchor{north}{\centerpoint\advance\pgf@y by \radius}%
	\anchor{north west}{
		\centerpoint%
		\pgf@xa=\radius%
		\advance\pgf@x by-.5\pgf@xa%
		\advance\pgf@y by .5\pgf@xa%
	}%
	\anchor{west}{
		\centerpoint%
		\pgf@xa=\radius%
		\advance\pgf@x by-   \pgf@xa%
		\advance\pgf@y by-.25\pgf@xa%
	}%
	\anchor{south}{
		\centerpoint%
		\pgf@xa=\radius%
		%guessed
		\advance\pgf@y by-.72\pgf@xa%
	}%
	\anchor{east}{
		\centerpoint%
		\pgf@xa=\radius%
		\advance\pgf@x by    \pgf@xa%
		\advance\pgf@y by-.25\pgf@xa%
	}%
	\anchor{north east}{
		\centerpoint%
		\pgf@xa=\radius%
		\advance\pgf@x by.75\pgf@xa%
		\advance\pgf@y by .25\pgf@xa%
	}%
	%
	\savedmacro\manifoldparameters{%
		\pgfmathsetmacro\shapeborderrotate{\pgfkeysvalueof{/pgf/shape border rotate}}%
		\addtosavedmacro\shapeborderrotate%
	}%
	%
	\backgroundpath{%
		\manifoldparameters%
		{% Make sure transformations are inside group.
			\pgftransformshift{\centerpoint}%
			\pgftransformrotate{\shapeborderrotate}%
			\pgfutil@tempdima=\radius%
			\pgfpathmoveto{\pgfqpoint{0pt}{\pgfutil@tempdima}}%
			\pgfpathcurveto%
				{\pgfqpoint{-.25\pgfutil@tempdima}{    \pgfutil@tempdima}}%
				{\pgfqpoint{-.25\pgfutil@tempdima}{ .75\pgfutil@tempdima}}%
				{\pgfqpoint{-.5 \pgfutil@tempdima}{ .5 \pgfutil@tempdima}}%
			\pgfpathcurveto%
				{\pgfqpoint{-.75\pgfutil@tempdima}{ .25\pgfutil@tempdima}}%
				{\pgfqpoint{-   \pgfutil@tempdima}{ .25\pgfutil@tempdima}}%
				{\pgfqpoint{-   \pgfutil@tempdima}{-.25\pgfutil@tempdima}}%
			\pgfpathcurveto%
				{\pgfqpoint{-   \pgfutil@tempdima}{-.75\pgfutil@tempdima}}%
				{\pgfqpoint{    \pgfutil@tempdima}{-   \pgfutil@tempdima}}%
				{\pgfqpoint{    \pgfutil@tempdima}{-.25\pgfutil@tempdima}}%
			\pgfpathcurveto%
				{\pgfqpoint{    \pgfutil@tempdima}{-.25\pgfutil@tempdima}}%
				{\pgfqpoint{    \pgfutil@tempdima}{.125\pgfutil@tempdima}}%
				{\pgfqpoint{ .75\pgfutil@tempdima}{ .25\pgfutil@tempdima}}%
			\pgfpathcurveto%
				{\pgfqpoint{ .25\pgfutil@tempdima}{ .5 \pgfutil@tempdima}}%
				{\pgfqpoint{ .5 \pgfutil@tempdima}{    \pgfutil@tempdima}}%
				{\pgfqpoint{0pt}{\pgfutil@tempdima}}%
		}%
	}
}
\protect
% TODO: https://ctan.math.illinois.edu/graphics/pgf/contrib/makeshape/makeshape.pdf

%do not think about vis at first, only raw data
%a) cell level discretization (clustering), then cluster labelling (cell type) …
%b) … then DE
%c) gene level discretization (correlation modules) to be able to interpret gene results
%d) cell networks (e.g. PAGA) for e) pseudotime (less discretization) f) dim. red. g) kernels like Gene Relevance
%or
%a) Clustering -> [d) DE | e) Labelling]
%b) PAGA -> [e) | f) Trajectories]
%c) Scoring -> [g) Gene Modules | h) GR]

\usetikzlibrary[calc]
\starttikzpicture[
	paga/.style={circle, draw, fill=white},
	arr/.style={->, shorten <=15mm},
]

% debug code
%\node[manifold, draw] (x) {};
%\foreach \anchor in {center,north,north west,west,south,east,north east}{
%	\draw[red] (x.\anchor) +(1pt, 1pt) -- +(-1pt, -1pt) +(-1pt, 1pt) -- +(1pt, -1pt);
%}

% main shapes
%a) Clustering -> [d) DE | e) Labelling]
%b) PAGA -> [e) | f) Trajectories]
%c) Scoring -> [g) Gene Modules | h) GR]
\node[manifold, draw, inner sep=1cm] (clust) at (0, 0) {};
\node[manifold, draw, inner sep=1cm] (trajy) at (4, 0) {};
\node[manifold, draw, inner sep=1cm] (score) at (8, 0) {};
\node[align=center] (de) at (-2, -3) {\bold{d)} Differential\\Expression};
\node[align=center] (lb) at ( 1, -3) {\bold{e)} Labelling};
\node[align=center] (tj) at ( 4, -3) {\bold{f)} Trajectories};
\node[align=center] (gm) at ( 7, -3) {\bold{g)} Gene\\Modules};
\node[align=center] (gr) at (10, -3) {\bold{h)} Gene\\Relevance};

\draw[arr] (clust) -- (de);
\draw[arr] (clust) -- (lb);
\draw[arr] (trajy) -- (lb);
\draw[arr] (trajy) -- (tj);
\draw[arr] (score) -- (gm);
\draw[arr] (score) -- (gr);

% a) cluster
\node[anchor=south east] at (clust.north west) {\bold{a)}};
\coordinate (clust a) at ($(clust.center) + (-.4, -.4)$);
\coordinate (clust b) at ($(clust.center) + (.6, -.4)$);
\coordinate (clust c) at ($(clust.north west) + (.6, -.3)$);
\draw
	(clust.south) -- (clust a) -- (clust.west)
	(clust.south) -- (clust b) -- (clust.east)
	(clust.north west) -- (clust c) -- (clust.north)
	(clust a) -- (clust.center) -- (clust c)
	(clust.north east) -- (clust.center) -- (clust b)
;

% b) trajectory
\node[anchor=south east] at (trajy.north west) {\bold{b)}};
\node[paga, inner sep=1.5mm] (trajy a) at ($(trajy.west)   + ( .4,  .1)$) {};
\node[paga, inner sep=1.7mm] (trajy b) at ($(trajy.north)  + ( .1, -.5)$) {};
\node[paga, inner sep=2.0mm] (trajy c) at ($(trajy.east)   + (-.6,  .3)$) {};
\node[paga, inner sep=0.7mm] (trajy d) at ($(trajy.east)   + (-.3, -.2)$) {};
\node[paga, inner sep=1.0mm] (trajy e) at ($(trajy.south)  + ( .1,  .3)$) {};
\draw (trajy b) -- (trajy c) (trajy b) -- (trajy e);  % secondary
\node[paga, inner sep=2.7mm] (trajy o) at ($(trajy.center) + (-.1,  .0)$) {};
\draw
	(trajy o) -- (trajy a)
	(trajy o) -- (trajy b)
	(trajy o) -- (trajy c) -- (trajy d)
	(trajy o) -- (trajy e)
	(trajy o) -- (trajy d)  % secondary
;

% c) scoring
\node[anchor=south east] at (score.north west) {\bold{c)}};
\fill[white, inner color=black, outer color=white] ($(score.west)  + ( .6,  .1)$) circle (.4);
\fill[white, inner color=black, outer color=white] ($(score.east)  + (-.8,  .1)$) circle (.5);


\stoptikzpicture
