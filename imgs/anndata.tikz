\usetikzlibrary[fadings]%
\starttikzpicture

\definecolorgroup[set1][rgb][0.89:0.1:0.11,0.22:0.49:0.72,0.3:0.69:0.29,0.6:0.31:0.64,1.0:0.5:0.0,1.0:1.0:0.2,0.65:0.34:0.16,0.97:0.51:0.75,0.6:0.6:0.6]
% 1 rd, gr, bu
% 4 pu, or, yl
% 7 bn, pk, gy

\pgfmathsetmacro\obsh{6} \pgfmathsetmacro\obscols{5} \pgfmathsetmacro\obsmw{1.5}
\pgfmathsetmacro\varw{4.5} \pgfmathsetmacro\varcols{4} \pgfmathsetmacro\varmh{1.2}
\pgfmathsetmacro\varfaded{1.2}
\pgfmathsetmacro\offset{0.08}
\pgfmathsetmacro\colw{0.2}
\pgfmathsetmacro\gap{0.3}

\tikzstyle{every node}=[fill=white, fill opacity=1, inner sep=0, align=center]
\tikzstyle{every path}=[fill=white, fill opacity=0.8]

% layers
\foreach \shift in {2*\offset, \offset, 0} {
	\startscope[shift={(\shift, -\shift)}]
	\draw (0, 0) rectangle (\varw, \obsh);
	\stopscope
}
\node at (\varw/2, \obsh/2) {Expression\\Layers (2D)};

% obs
\foreach \shift in {1, 2, ..., \obscols} {
	\startscope[shift={(\varw + \gap + \shift*\colw - \colw, 0)}]
	\draw (0, 0) rectangle (\colw, \obsh);
	\stopscope
}
\node[rotate=-90] at (\varw + \gap + \obscols/2*\colw, \obsh/2) {1D observation annotations};

% obsm
\foreach \shift/\w in {2*\offset/1.2, \offset/1.8, 0/\obsmw} {
	\startscope[shift={(\varw + 2*\gap + \obscols*\colw + \shift, -\shift)}]
	\draw (0, 0) rectangle (\w, \obsh);
	\stopscope
}
\node[rotate=-90] at (\varw + 2*\gap + \obscols*\colw + \obsmw/2, \obsh/2) {2D observation annotations};

% obsp
\foreach \shift in {\offset, 0} {
	\startscope[shift={(-\gap + \shift, -\shift)}]
	\draw (0, 0) rectangle (-\obsh, \obsh);
	\stopscope
}
\node at (-\gap - \obsh/2, \obsh/2) {Graph annotations\\(square matrix)\\observation × observation};

% var
\foreach \shift in {1, 2, ..., \varcols} {
	\startscope[shift={(0, \obsh + \gap + \shift*\colw - \colw)}]
	\draw (0, 0) rectangle (\varw, \colw);
	\stopscope
}
\node at (\varw/2, \obsh + \gap + \varcols/2*\colw) {1D variable annotations};

% varm
\foreach \shift/\h in {\offset/0.8, 0/\varmh} {
	\startscope[shift={(\shift, \obsh + 2*\gap + \varcols*\colw - \shift)}]
	\draw (0, 0) rectangle (\varw, \h);
	\stopscope
}
\node at (\varw/2, \obsh + 2*\gap + \varcols*\colw + \varmh/2) {2D variable annotations};

% varp
\foreach \shift in {\offset, 0} {
	\startscope[shift={(\shift, -\gap-\shift)}]
	%\draw[path fading = south] (0, 0) rectangle (\varw, -0.3*\varw);
	\draw[path fading = south] (0, \shift - \varfaded) -- (0, 0) -| (\varw, \shift - \varfaded);
	\stopscope
}
\node at (\varw/2, -\gap - \varfaded/2) {Graph annotations\\variable×variable};

% uns

\pgfmathsetmacro\unsw{\obscols*\colw + \gap + \obsmw}
\pgfmathsetmacro\unsh{\varcols*\colw + \gap + \varmh}
\draw (\varw + \gap, \obsh + \gap) rectangle ++(\unsw, \unsh);
\node at (\varw + \gap + \unsw/2, \obsh + \gap + \unsh/2) {Unaligned\\annotations\\(Hierarchy)};

\stoptikzpicture
