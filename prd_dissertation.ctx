% !TEX program = context

\startproduct prd_dissertation
\environment env_dissertation.ctx

\usemodule[annotation]

\def\TODO{\dosingleempty\doTODO}
\def\doTODO[#1]{%
	\edef\gap{\iffirstargument: \fi}%
	\comment[symbol=Comment,color=red,width=9mm]{TODO\gap#1}%
}

\starttext

\setuppagenumbering[state=stop]
\setupheader[state=stop]

\startstandardmakeup[doublesided=no]

\tum

\vfill

\framed
    [frame=off, topframe=on, bottomframe=on, width=\textwidth, align=middle]
    {\tfd \title}

\vfill

\startalignment[middle]
\author
\stopalignment

\vfill

\startalignment[middle]
\date
\stopalignment

\vfill

\stopstandardmakeup

%\page[empty]

\component c_declaration.ctx

\page[empty]

\setuppagenumbering[state=start]
\setupheader[state=start]

\startfrontmatter

\component c_danksagung.ctx
\component c_abstract.ctx
\component c_publist.ctx

\completecontent[criterium=all]

\stopfrontmatter

\startbodymatter

\component c_introduction.ctx
\component c_methods.ctx
\component c_conclusion.ctx

\startchapter[title=References]
\placebtxrendering[main][method=global]
\stopchapter

%\startchapter[title=Appendix]
%\copypages[../code/mca/mca.pdf][n=8]
%\stopchapter

\stopbodymatter

\stoptext

\stopproduct
