{
    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": false,
    "todo-tree.regex.regex": "((?<!\\\\def)(//|#|<!--|;|/\\*|^|\\\\)\\s*($TAGS)|^\\s*- \\[ \\])",
    "todo-tree.ripgrep.ripgrepArgs": "--max-columns=1000 --no-config --pcre2 ",
    "python.defaultInterpreterPath": ".venv/bin/python",
    "editor.wordWrap": "on",
    "cSpell.enabled": true,
    "grammarly.files.include": ["**/*.mkiv"],
    "grammarly.config.documentDomain": "academic",
    "grammarly.config.documentDialect": "american",
}
