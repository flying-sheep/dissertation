{
    "spellright.language": [
        "en",
        "en_US"
    ],
    "spellright.documentTypes": [
        "markdown",
        "latex",
        "context",
        "plaintext"
    ],
    "spellright.parserByClass": {
        "context": {
            "parser": "latex"
        }
    },
    "spellright.ignoreRegExpsByClass": {
        "context": [
            "/\\\\starttikzpicture[^]*?\\\\stoptikzpicture/gm",
            "/\\\\startformula[^]*?\\\\stopformula/gm",
            "/\\\\startluacode[^]*?\\\\stopluacode/gm",
            "/\\$[^\\$]+?\\$(’s|th)/g",
            "/\\{[^\\}]+?\\}(’s|th)/g",
            "/\\\\startproduct.*/g"
        ]
    },
    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": false,
    "todo-tree.regex.regex": "((//|#|<!--|;|/\\*|^|\\\\)\\s*($TAGS)|^\\s*- \\[ \\])",
    "python.pythonPath": "/Users/pangerer/Documents/dissertation/.venv/bin/python3",
    "editor.wordWrap": "on"
}