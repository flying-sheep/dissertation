\definemathcommand[lr][nolop]{\mfunction{LR}}
\definemathcommand[gr][nolop]{\mfunction{GR}}
\definemathcommand[rank][nolop]{\mfunction{rg}}
\definemathcommand[gradnorm]{\left\|\left\|∇_{gc}\right\|\right\|_2}

% https://de.wikipedia.org/wiki/Nabla-Operator
% Gerechnet wird mit dem Nabla-Operator wie mit einem Vektor, wobei das „Produkt“ von beispielsweise ∂ / ∂x_i mit einer rechts davon stehenden Funktion f als partielle Ableitung ∂f / ∂x_i interpretiert wird. 
% ∇f is the gradient of the function f, and I think that’s in our case the function mapping the embedding to the gene expressions, so the inverse of the embedding function.

\placeformula
\startformula
∇_{gc} = \left(\frac{∂ x_{gc}}{∂ s_{1c}}, …, \frac{∂ x_{gc}}{∂ s_{Pc}}\right)
\stopformula

\placeformula
\startformula
\widehat{∇_{gc}} = \left(
\startcases[left={\left.}, style=\displaystyle]
\NC \mathit{NA}, \NC \text{if } x_{gc} = 0 \NR
\NC \underset{n ∈ \text{NN}_k(c) ∧ n≠c}\median \frac{x_{gc}-x_{gn}}{s_{pn}-s_{pc}}, \NC \text{otherwise} \NR
\stopcases
\right)
\stopformula

\placeformula
\startformula
\gradnorm = \sqrt{∑_{p=1}^P \left(∇_{gc}\right)_p^2}
\stopformula

It begins with an experiment to prepare and sequence a transcript library containing mostly mature mRNA but also unspliced mRNA and other RNA (see \infig[fig:rna-seq]a).

\placeformula
\startformula
\lr_{\rank_{\max}}(g, Ψ) = \frac{ ∑_{c∈Ψ} \left[ \rank_{\gradnorm} < \rank_{\max} \right] }{|Ψ|}
\stopformula

\placeformula
\startformula
\left[P\right] =
\startcases
\NC 1, \NC \text{if $P$ is true} \NR
\NC 0, \NC \text{otherwise} \NR
\stopcases
\text{, for any predicate $P$}
\stopformula

\placeformula
\startformula
\gr_{\rank_{\max}}(g) = \lr_{\rank_{\max}}(g, \{1,…,C\})
\stopformula

\placeformula
\startformula
l_c^m = \argmax_{g ∈ Ω} 
\startcases
\NC \gradnorm, \NC \text{ if $m=0$} \NR
\NC \frac1k ∑_{n ∈ \text{NN}_k(c)} \left[ l_n^{m-1} = g \right], \NC \text{ otherwise.} \NR
\stopcases
\stopformula

