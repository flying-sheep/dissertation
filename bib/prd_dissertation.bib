
@Article{	  aho1975,
  abstract	= {This paper describes a simple, efficient algorithm to locate all occurrences of any of a finite number of keywords in a string of text. The algorithm consists of constructing a finite state pattern matching machine from the keywords and then using the pattern matching machine to process the text string in a single pass. Construction of the pattern matching machine takes time proportional to the sum of the lengths of the keywords. The number of state transitions made by the pattern matching machine in processing the text string is independent of the number of keywords. The algorithm has been used to improve the speed of a library bibliographic search program by a factor of 5 to 10. {\textcopyright} 1975, ACM. All rights reserved.},
  author	= {Aho, Alfred V. and Corasick, Margaret J.},
  doi		= {10.1145/360825.360855},
  issn		= {15577317},
  journal	= {Communications of the ACM},
  keywords	= {bibliographic search,computational complexity,finite state machines,information retrieval,keywords and phrases,string pattern matching,text-editing},
  month		= {jun},
  number	= {6},
  pages		= {333--340},
  title		= {{Efficient String Matching: An Aid to Bibliographic Search}},
  url		= {http://portal.acm.org/citation.cfm?doid=360825.360855},
  volume	= {18},
  year		= {1975}
}

@Article{	  andrews2018,
  abstract	= {Background: Single-cell RNASeq is a powerful tool for measuring gene expression at the resolution of individual cells. A significant challenge in the analysis of this data is the large amount of zero values, representing either missing data or no expression. Several imputation approaches have been proposed to deal with this issue, but since these methods generally rely on structure inherent to the dataset under consideration they may not provide any additional information.},
  annote	= {A comparison of 5 imputation methods with a specific focus on false-positive signals. On simulated data, SAVER performed well and did not generate false positives, while all other methods did (scImpute, MAGIC, DrImpute, and knn-smooth). On real data, results varied and all methods produced false-positives.
		  
		  It was argued that imputing data is just a method of increasing sensitivity and lowering specificity of a statistical test. This seems harsh, but seems founded in the case of imputation for differential testing.
		  
		  "Hence no new information is gained, making it analogous to simply lowering the significance threshold of any statistical test applied to the data"
		  
		  It would be interesting to see this done on newer methods such as DCA, and scVI as well.},
  author	= {Andrews, Tallulah S. and Hemberg, Martin},
  doi		= {10.12688/f1000research.16613.1},
  issn		= {2046-1402},
  journal	= {F1000Research},
  keywords	= {Comparison,Gene expression,Imputation,RNA-seq,Reproducibility,Type 1 errors,scRNA-seq analysis,single-cell},
  mendeley-tags	= {Comparison,Imputation,scRNA-seq analysis},
  month		= {nov},
  pages		= {1740},
  title		= {{False signals induced by single-cell imputation}},
  url		= {https://f1000research.com/articles/7-1740/v1},
  volume	= {7},
  year		= {2018}
}

@Article{	  angerer2016,
  abstract	= {Diffusion maps are a spectral method for non-linear dimension reduction and have recently been adapted for the visualization of single cell expression data. Here we present destiny, an efficient R implementation of the diffusion map algorithm. Our package includes a single-cell specific noise model allowing for missing and censored values. In contrast to previous implementations, we further present an efficient nearest-neighbour approximation that allows for the processing of hundreds of thousands of cells and a functionality for projecting new data on existing diffusion maps. We exemplarily apply destiny to a recent time-resolved mass cytometry dataset of cellular reprogramming.},
  author	= {Angerer, Philipp and Haghverdi, Laleh and B{\"{u}}ttner, Maren and Theis, Fabian J and Marr, Carsten and Buettner, Florian},
  doi		= {10.1093/bioinformatics/btv715},
  issn		= {14602059},
  journal	= {Bioinformatics},
  language	= {en},
  number	= {8},
  pages		= {1241--1243},
  shorttitle	= {{\textless}i{\textgreater}destiny{\textless}/i{\textgreater}},
  title		= {{Destiny: Diffusion maps for large-scale single-cell data in R}},
  url		= {http://bioinformatics.oxfordjournals.org/lookup/doi/10.1093/bioinformatics/btv715 files/103/Angerer et al. - 2016 - destiny diffusion maps for large-scale single-cel.pdf},
  volume	= {32},
  year		= {2016}
}

