\usemodule[tikz]

\usemodule[pgfplots] % needs to be before \usetikzlibrary calls
\pgfplotsset{compat=1.14}
% \usepgfplotslibrary[groupplots]
\unexpanded\def\startgroupplot{\groupplot}
\unexpanded\def\stopgroupplot{\endgroupplot}
% \usemodule[pgfplotstable]
%\usepgfplotslibrary[groupplots]

% https://tikz.dev/pgfplots/pgfplotstable-load-data
% Applies to both `\pgfplotstableread` and `\addplot table`
\pgfplotsset{
	table/search path={data},
}

\usetikzlibrary[positioning] % needs to be after pgfplots
\usetikzlibrary[decorations.pathreplacing]
\usetikzlibrary[backgrounds] %\tikz[framed] for debugging
\usetikzlibrary[shapes]
%\usetikzlibrary[shadings]
\usetikzlibrary[arrows.meta]
\usetikzlibrary[fadings]
\usetikzlibrary[calc]
%\usetikzlibrary[external]
%\tikzexternalize[prefix=imgs/]

\usemodule[logos]

\catcode`√=13\def√{\sqrt}
\catcode`∜=13\def∜{\sqrt[4]}
