\definemathfunction[argmin][mathlimits=auto]
\definemathfunction[argmax][mathlimits=auto]

\definemathfunction[LR][mathlimits=no]
\definemathfunction[GR][mathlimits=no]
\definemathfunction[rank][mathlimits=no]

