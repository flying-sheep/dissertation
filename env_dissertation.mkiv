\startenvironment env_dissertation
\usepath[{parts}]

\enableregime[utf-8]
\mainlanguage[en]
\setuplanguage[en][spacing=packed] % no double space after sentences

% Interoperability: Unifying/connecting methods through frameworks
% Discoverability: Best practice tools pre-selected
% Stabilization: Focus on interpretation by having reproducibility and frameworks instead of glue code
% “Frameworks of interpretation”
% “Codifying the tools of the trade”
\def\doctitle{Frameworks of interpretation: stabilizing scRNA-Seq data processing for discovery}
\def\author{Philipp J.G.F. Angerer}
\def\kindofwork{Ph.D. Thesis}
\def\topicofwork{Computational Biology}

% Page layout
\setuplayout[
	alternative=doublesided,
	width=middle,
	headerdistance=0cm,
	header=1cm,
	footerdistance=0cm,
	footer=0cm,
]
% Page numbering
\setuppagenumbering[
	state=start,
	alternative=singlesided,
	location={header, right},
	style=sans,
	way=bypart,
	sectionnumber=no,
	strut=yes,
]
% Headers & footers
\setupheader[text][after=\vskip 4pt \hrule]
\setupheadertexts
	[{\userpagenumber}]
	[{\getmarking[chapternumber]\ \getmarking[chapter]}]
	[{\userpagenumber}]
	[{\getmarking[chapternumber]\ \getmarking[chapter]}]

% Allow colors
\setupcolors[state=start]
\setupbar[color=black]
% Links & document metadata
\setupinteraction[
	state=start,
	color=,
	contrastcolor=,
	% Document metadata
	title=\doctitle,
	subtitle={\kindofwork\ in \topicofwork},
	author=\author,
	% Don’t switch to fit page mode on link click
	focus=standard,
]
% \setupsynctex[state=start] % Takes time and doesn’t seem to work in Kile
% keep track of the number but don’t show it
\setuphead[title][incrementnumber=yes, number=no]
% Make all section titles interactive, and show titles too
\setupcombinedlist[content][interaction=all,list={chapter,section,subsection,subsubsection,title}]

% Which PDF bookmarks to create and which ones to open
\placebookmarks[chapter,title,section,subsection,subsubsection][chapter,title,section][force=yes]
\setupinteractionscreen[option=bookmark]
\enabledirectives[interaction.identity.preroll]  % prevent TeX from appering in title metadata
\enabledirectives[references.bookmarks.preroll]  % prevent TeX from appering in PDF bookmarks

% % Vim syntax highlighting
%\usemodule[vim]
%\definevimtyping[python][syntax=python, strip=yes, lines=split, escape=on]
%\definevimtyping[R][syntax=r, strip=yes]

% Typography settings
\setupalign[hz, hanging, tolerant] % Breaks: Font expansion, Protruding punct., tolerance
\definefontfeature[default][default][ % https://docs.microsoft.com/en-us/typography/opentype/spec/features_ae
	liga=yes, tlig=yes, ccmp=yes, % ligatures and glyph composition/decomposition
	kern=yes, % kerning
	onum=yes, % oldstyle numbers
	expansion=quality, protrusion=quality,
	trep=no, mode=node, % text replacement like '→’
]
\setupbodyfontenvironment[default][em=italic] %italic instead of slanted
\setupindenting[yes, medium] % Indent paragraph starts
\setbreakpoints[compound] % Allow breaking after dashes

% hyphenation
\hyphenation{chan-ges}
\hyphenation{u-bi-qui-tous}
\hyphenation{me-thy-la-tion}
\hyphenation{he-te-ro-ge-ne-i-ty}
\hyphenation{mar-kers}

% Font settings, need to be after typography
%\usetypescriptfile[type-imp-euler.mkiv]
%\usetypescript[eulernova]
%\usetypescriptfile[type-luxi]
%\usetypescript[type-luxi]
\definefontfamily[myfonts][serif][TeX Gyre Pagella] % Palatino
\definefontfamily[myfonts][math][TeX Gyre Pagella Math] % AMS Euler or TeX Gyre Pagella Math or XITS Math
\definefontfamily[myfonts][sans][TeX Gyre Heros]   %Helvetica
\definefontfamily[myfonts][mono][Luxi Mono][rscale=0.86]  % or: Tex Gyre Cursor
\setupbodyfont[myfonts, 12pt]

% small caps
\def\n#1{\smallcaps{#1}}

% Heading style
\setuphead[chapter]      [style=\ss\bfc, align=flushleft]
\setuphead[section]      [style=\ss\bfb, align=flushleft]
\setuphead[subsection]   [style=\ss\bfa, align=flushleft]
\setuphead[subsubsection][style=\ss\bf,  align=flushleft]
\setuplabeltext[en][appendix=Appendix~]
\define[2]\AppendixHeader
  {\framed[frame=off,width=broad,align=flushleft]{\ss\bfc#1\crlf#2}}
\startsectionblockenvironment[appendix]
\setuphead[chapter][command=\AppendixHeader]
\stopsectionblockenvironment

% List environments
\definedescription[desc][
	headstyle=bold, style=normal,
	align=justify, alternative=hanging,
	width=broad, margin=1cm,
]

% Floating environments
\setupcombinations[location=top, alternative=text]
\definefloat[listing][listings]
\setupcaption[figure][hang=yes, indentnext=no]
\definefloat[subfigure][subfigures]
\setupfloat[subfigure][local=yes]
\setupcaption[subfigure][number=yes, numberconversion=a, style=bold, location=right]
\setuplabeltext[subfigure=]
\appendvalue{stopplacefigure}{\resetcounter[subfigure]}
\definefloat[narrowfigure][figures][figure]
\setupcaption[narrowfigure][location=right, hang=no]

% Tables
\setupTABLE[c][each][align={middle,lohi},frame=off]

\usemodule[database]
\defineseparatedlist
	[TSV]
	[separator=tab,first=\bTR,last=\eTR,left=\bTD,right=\eTD]
\defineseparatedlist
	[CSV]
	[separator=comma,first=\bTR,last=\eTR,left=\bTD,right=\eTD]

%\startseparatedlist[TSV]
%\startTSV
%\processseparatedfile[TSV][filename]

% references
\setupreferencing[left=, right=]

% Citations/Bibliography
% http://pragma-ade.nl/general/manuals/mkiv-publications.pdf
\definebtxdataset[main]
\usebtxdataset[main][bib/\jobname.bib]
\setupbtx[dataset=main] % make \cite use this by default
\setupbtx[default:cite][alternative=authoryear] % default so the shortcut \cite[ref] can be used
\usebtxdefinitions[apa] % load apa styles for bib entry and \cite rendering
\setupbtx[apa:cite][otherstext={ et al.}, etallimit=3]
\setupbtx[apa:list][etallimit=, etaldisplay=]

\definebtxrendering[main][apa][dataset=main, pagestate=start] % define a bib entry rendering to use with \placebtxrendering (sorting, numbering=no, …)
% \newbibfield[timestamp]
% \setuppublicationlayout[electronic]{%
% 	\insertauthors{}{. }{}%
% 	\inserttitle{}{ }{}%
% 	\inserturl{\bgroup\tt}{\egroup\ }{}%
% 	\inserttimestamp{accessed:}{ }{}%
% 	\insertnote{ }{.}{}%
% }
\def\inlinecite[#1]{\cite[authoryears][#1]}
\def\inbracecite[#1]{\cite[authoryear,left=,right=][#1]}

% command to extract titles
\startluacode
local luadata = publications.datasets.main.luadata
--for tag, entry in next, luadata do
--    if entry.title then
--        logs.report("btx", "tag: %a, title: %a", entry.tag, entry.title)
--    end
--end

userdata = userdata or {}

function userdata.cite_title(tag)
    tex.print(luadata[tag].title)
end
\stopluacode

\def\placecitationtitle#1{\ctxlua{userdata.cite_title([==[#1]==])}}

\def\titlecite#1{\placecitationtitle{#1} \cite[#1]}

\def\embedappendix{\dosingleempty\doEmbedappendix}
\def\doEmbedappendix[#1]#2{\page[odd]
\startchapter[title={\titlecite{#2}}, #1]
\cite[alternative=entry, left=, right=][#2]
\page
\copypages[publications/#2.pdf][][scale=900]
\stopchapter}

% \usemodule[res-08] \setups[rl:manipulate]
\setupexternalfigures[directory=imgs,conversion=pdf]
